{
  "title": "Generate Handoff Manifests",
  "type": "action",
  "description": "Generates JSON Schema v2.2 manifests (INCIDENT_MANIFEST.json and JOB_MANIFEST.json) for Cloud TPU diagnostic handoff.",
  "internal_only": false,
  "tags": [
    "triage",
    "analysis",
    "storage"
  ],
  "created": "2026-10-01",
  "updated": "2026-10-01",
  "entrypoints": [
    "troubleshoot"
  ],
  "execution_mode": "command",
  "instruction": "python3 tools/scripts/handoff/generate_manifest.py --findings=${findings}$([ -n \"${mode}\" ] && echo \" --mode=${mode}\")$([ -n \"${output_file}\" ] && echo \" --output_file=${output_file}\")$([ -n \"${output_dir}\" ] && echo \" --output_dir=${output_dir}\")$([ -n \"${bucket}\" ] && echo \" --bucket=${bucket}\")",
  "summary_fields": [
    "status",
    "output_file"
  ],
  "parameters": {
    "findings": {
      "type": "string",
      "description": "Path to troubleshoot_findings.json"
    },
    "mode": {
      "type": "string",
      "default": "job",
      "description": "Manifest mode: incident or job"
    },
    "output_file": {
      "type": "string",
      "default": "",
      "description": "Destination path for generated JSON manifest"
    },
    "output_dir": {
      "type": "string",
      "default": "",
      "description": "Destination directory for generated manifests"
    },
    "bucket": {
      "type": "string",
      "default": "",
      "description": "Optional GCS bucket override"
    }
  }
}
